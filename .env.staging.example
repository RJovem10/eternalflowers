# ===== .env.staging.example — Variáveis para Staging Local =====
# Copiar para .env.staging.local e preencher valores reais.
# .env.staging.local está em .gitignore — nunca versionar secrets.
#
# Uso:
#   docker compose -f docker-compose.staging.yml --env-file .env.staging.local up -d
#   bash scripts/staging/setup.sh           (carrega .env.staging.local automaticamente)
#
# Única fonte de verdade para password PostgreSQL:
#   POSTGRES_PASSWORD
#
# DATABASE_URI é construída em memória pelos scripts.
# Se definires DATABASE_URI explicitamente, terá precedência.
# ================================================================

# ===== PostgreSQL =====
POSTGRES_USER=staging
POSTGRES_PASSWORD=<DEFINIR>
POSTGRES_DB=eternal_flowers_staging

# ===== Payload =====
PAYLOAD_SECRET=<GERAR_SECRET_64_HEX>

# ===== Site =====
NEXT_PUBLIC_SERVER_URL=http://localhost:3003
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# ===== Stripe (deixar vazio em staging) =====
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ===== Instagram API =====
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=

# ===== Staging internals =====
SOURCE_SQLITE=<DEFINIR_PATH_DA_SQLITE_CANONICA>
STAGING_MEDIA_DIR=<DEFINIR>
STAGING_PG_PORT=55433
STAGING_APP_PORT=3003
STAGING_ADMIN_EMAIL=<DEFINIR>
STAGING_ADMIN_PASSWORD=<DEFINIR>