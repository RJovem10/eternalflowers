# ===== .env.staging.example — Variáveis para Staging Local =====
# Copiar para .env.staging.local e preencher valores reais.
# .env.staging.local está em .gitignore — nunca versionar secrets.
#
# Uso:
#   source .env.staging.local
#   ou: export $(grep -v '^#' .env.staging.local | xargs)
#
# ================================================================

# ===== Base de dados =====
# PostgreSQL staging local (porta mapeada no docker-compose.staging.yml)
DATABASE_URI=postgresql://staging:staging_password_change_me@127.0.0.1:55433/eternal_flowers_staging

# ===== Payload =====
PAYLOAD_SECRET=staging-payload-secret-change-me-staging-payload-secret

# ===== Site =====
NEXT_PUBLIC_SERVER_URL=http://localhost:3003
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# ===== Stripe (deixar vazio em staging — sem pagamentos reais) =====
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ===== Instagram API =====
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=

# ===== Staging internals =====
SOURCE_SQLITE=/home/jovem/backups/eternalflowers/testing/e2/e2-validation.sqlite
STAGING_MEDIA_DIR=/home/jovem/workspace/loja-flores-marina/media-staging
STAGING_PG_PORT=55433
STAGING_APP_PORT=3003
STAGING_PG_HOST=127.0.0.1
STAGING_PG_USER=staging
STAGING_PG_PASS=staging_password_change_me
STAGING_PG_DB=eternal_flowers_staging