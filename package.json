    "staging:stop": "bash scripts/staging/stop.sh",
    "staging:status": "bash scripts/staging/status.sh",
    "staging:test": "bash scripts/staging/smoke-test.sh",
    "staging:logs": "docker logs eternal-flowers-staging-db",
    "staging:backup": "bash scripts/staging/backup.sh",
    "staging:restore": "bash scripts/staging/restore.sh",
    "staging:teardown": "bash scripts/staging/teardown.sh",
    "staging:purge": "bash scripts/staging/teardown.sh --purge"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/db-sqlite": "^3.0.0",
