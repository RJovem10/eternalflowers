    "better-sqlite3": "^11.0.0",
    "next": "15.4.11",
    "payload": "^3.0.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "stripe": "^18.5.0",
