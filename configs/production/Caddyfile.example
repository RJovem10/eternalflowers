<DOMINIO> {
    # Reverse proxy para a aplicação Next.js/Payload
    reverse_proxy app:3000

    # Segurança
    header {
        # HSTS (6 meses, inclui subdomínios, preload)
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"

        # Prevenir clickjacking
        X-Frame-Options "DENY"

        # Proteção XSS
        X-XSS-Protection "1; mode=block"

        # Prevenir MIME sniffing
        X-Content-Type-Options "nosniff"

        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Permissions policy — restringir APIs não utilizadas
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # Content Security Policy (ajustar se necessário)
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'none'"
    }

    # Comprimir respostas
    encode gzip

    # Ficheiros estáticos — cache agressivo
    handle_path /_next/static/* {
        root * /app
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    handle_path /media/* {
        root * /app
        file_server
        header Cache-Control "public, max-age=86400"
    }

    handle_path /favicon.ico {
        root * /app/public
        file_server
        header Cache-Control "public, max-age=86400"
    }

    handle_path /robots.txt {
        root * /app/public
        file_server
    }

    # Healthcheck para monitorização
    @health {
        path /api/health
    }
    handle @health {
        respond "OK" 200
    }

    # Redirecionar HTTP para HTTPS (automático no Caddy)
}

# Redirecionar www para o domínio principal
www.<DOMINIO> {
    redir https://<DOMINIO>{uri} 301
}