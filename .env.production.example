# ===== .env.production.example =====
# Copiar para .env.production e preencher com valores reais.
# .env.production está em .gitignore — NUNCA versionar.
#
# Uso (PREFERIDO):
#   ./scripts/production/compose.sh up -d
#
# Equivalente manual (obrigatório --env-file):
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d
#
# ⚠️  NUNCA executar docker compose sem --env-file .env.production.
#     O wrapper scripts/production/compose.sh garante isto.
# =================================================================

# ===== Base de dados PostgreSQL =====
# Utilizador não-superuser, sem acesso público.
POSTGRES_USER=<DEFINIR>
POSTGRES_PASSWORD=<GERAR_SECRET_32_CHARS>
POSTGRES_DB=loja_flores

# Connection string da aplicação
DATABASE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ===== Payload =====
# Gerar com: openssl rand -hex 32 (64 caracteres hexadecimais)
PAYLOAD_SECRET=<GERAR_SECRET_64_HEX>

# ===== Site =====
# Domínio público da loja — usado para URLs canónicas e Open Graph
NEXT_PUBLIC_SITE_URL=https://<DOMINIO>
NEXT_PUBLIC_SERVER_URL=https://<DOMINIO>

# ===== Stripe (preencher quando a conta estiver ativa) =====
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Email (Resend) =====
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ===== Instagram API (@eternal.flowers.pt) =====
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=

# ===== Manutenção (server-to-server) =====
# Secret para autenticar chamadas ao endpoint POST /api/internal/maintenance
# Gerar com: openssl rand -hex 32
MAINTENANCE_SECRET=<GERAR_SECRET_64_HEX>

# ===== Seed (apenas para setup inicial — remover depois) =====
SEED_ADMIN_EMAIL=<EMAIL_ADMIN>
SEED_ADMIN_PASSWORD=<GERAR_SECRET_16_CHARS>