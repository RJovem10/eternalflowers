# ===== Base de dados =====
# Dev local (SQLite): DEIXA DATABASE_URI VAZIO ou 'file:./loja.sqlite'
# VPS (Postgres): define a connection string
DATABASE_URI=postgresql://loja:substituir_password@postgres:5432/loja_flores

# ===== Payload =====
PAYLOAD_SECRET=gera-um-segredo-forte-aqui

# ===== Site =====
# NEXT_PUBLIC_SITE_URL tem precedência (definir no ambiente de produção)
# NEXT_PUBLIC_SERVER_URL é fallback (usado pelo Payload)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ===== Stripe (preencher quando a conta PT estiver confirmada) =====
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ===== Instagram API (@eternal.flowers.pt) =====
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=

# ===== Seed Admin (scripts/seed.py) =====
SEED_ADMIN_EMAIL=<DEFINIR>
SEED_ADMIN_PASSWORD=<DEFINIR>

# ===== Email (Resend) =====
# Provider activo: resend
EMAIL_PROVIDER=resend
# Chave API do Resend (server-side apenas)
RESEND_API_KEY=
# Endereço de envio (com nome opcional, ex: "Eternal Flowers <orders@exemplo.pt>")
EMAIL_FROM=
# Endereço de resposta opcional
EMAIL_REPLY_TO=
